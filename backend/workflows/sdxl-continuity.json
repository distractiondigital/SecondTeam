{
  "name": "SDXL + depth, pose, regional prompts and references",
  "description": "The base graph: an SDXL checkpoint guided by the shot's depth pass (softened) and pose pass through the Union ControlNet. Values written {{like_this}} are filled in by the app; {{in:model}} and {{in:positive}} are links the app wires to the end of the reference chain (IP-Adapter per cast member/prop, from fragments/reference.json and style.json) and the regional-prompt chain (fragments/region.json). {{in:posed}} is what the pose guide receives: the depth-guided set conditioning plus the figures' own regions, which skip the depth guide. With no cast, props or style images they are simply the checkpoint's model and the global prompt. See src/main/backend/workflow.ts (composeWorkflow).",
  "output": "11",
  "prompt": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "{{checkpoint}}"
      },
      "_meta": {
        "title": "Model"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{positive}}",
        "clip": [
          "1",
          1
        ]
      },
      "_meta": {
        "title": "Prompt"
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative}}",
        "clip": [
          "1",
          1
        ]
      },
      "_meta": {
        "title": "Negative prompt"
      }
    },
    "4": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{depth_image}}"
      },
      "_meta": {
        "title": "Depth pass"
      }
    },
    "15": {
      "class_type": "ImageBlur",
      "inputs": {
        "image": [
          "4",
          0
        ],
        "blur_radius": "{{depth_blur_radius}}",
        "sigma": "{{depth_blur_sigma}}"
      },
      "_meta": {
        "title": "Soften depth (keep the layout, lose the mannequin's joints)"
      }
    },
    "5": {
      "class_type": "ControlNetLoader",
      "inputs": {
        "control_net_name": "{{controlnet}}"
      },
      "_meta": {
        "title": "Union ControlNet"
      }
    },
    "6": {
      "class_type": "SetUnionControlNetType",
      "inputs": {
        "control_net": [
          "5",
          0
        ],
        "type": "depth"
      },
      "_meta": {
        "title": "Use it for depth"
      }
    },
    "7": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": "{{in:positive}}",
        "negative": [
          "3",
          0
        ],
        "control_net": [
          "6",
          0
        ],
        "image": [
          "15",
          0
        ],
        "vae": [
          "1",
          2
        ],
        "strength": "{{cn_strength}}",
        "start_percent": "{{cn_start}}",
        "end_percent": "{{cn_end}}"
      },
      "_meta": {
        "title": "Apply depth"
      }
    },
    "12": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{pose_image}}"
      },
      "_meta": {
        "title": "Pose pass"
      }
    },
    "13": {
      "class_type": "SetUnionControlNetType",
      "inputs": {
        "control_net": [
          "5",
          0
        ],
        "type": "openpose"
      },
      "_meta": {
        "title": "Use it for pose"
      }
    },
    "14": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": "{{in:posed}}",
        "negative": [
          "7",
          1
        ],
        "control_net": [
          "13",
          0
        ],
        "image": [
          "12",
          0
        ],
        "vae": [
          "1",
          2
        ],
        "strength": "{{pose_strength}}",
        "start_percent": 0,
        "end_percent": "{{pose_end}}"
      },
      "_meta": {
        "title": "Apply pose"
      }
    },
    "8": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": "{{width}}",
        "height": "{{height}}",
        "batch_size": 1
      },
      "_meta": {
        "title": "Size"
      }
    },
    "9": {
      "class_type": "KSampler",
      "inputs": {
        "model": "{{in:model}}",
        "positive": [
          "14",
          0
        ],
        "negative": [
          "14",
          1
        ],
        "latent_image": [
          "8",
          0
        ],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1
      },
      "_meta": {
        "title": "Sample"
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "9",
          0
        ],
        "vae": [
          "1",
          2
        ]
      },
      "_meta": {
        "title": "Decode"
      }
    },
    "11": {
      "class_type": "PreviewImage",
      "inputs": {
        "images": [
          "10",
          0
        ]
      },
      "_meta": {
        "title": "Result (temp; the app copies it into the project)"
      }
    },
    "20": {
      "class_type": "IPAdapterModelLoader",
      "inputs": {
        "ipadapter_file": "{{ipadapter}}"
      },
      "_meta": {
        "title": "IP-Adapter model (only used when there are references)"
      }
    },
    "21": {
      "class_type": "CLIPVisionLoader",
      "inputs": {
        "clip_name": "{{clip_vision}}"
      },
      "_meta": {
        "title": "Image encoder for references"
      }
    },
    "22": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{id_image}}"
      },
      "_meta": {
        "title": "Object ID pass (masks for regions and references)"
      }
    }
  }
}
