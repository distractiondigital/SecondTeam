{
  "name": "Masked reference (IP-Adapter)",
  "description": "A cast member's / prop's reference images, guiding only inside its mask.",
  "outputs": {
    "model": [
      "apply",
      0
    ]
  },
  "nodes": {
    "prep": {
      "class_type": "PrepImageForClipVision",
      "inputs": {
        "image": "{{in:image}}",
        "interpolation": "LANCZOS",
        "crop_position": "pad",
        "sharpening": 0
      }
    },
    "apply": {
      "class_type": "IPAdapterAdvanced",
      "inputs": {
        "model": "{{in:model}}",
        "ipadapter": "{{in:ipadapter}}",
        "clip_vision": "{{in:clip_vision}}",
        "image": [
          "prep",
          0
        ],
        "attn_mask": "{{in:mask}}",
        "weight": "{{weight}}",
        "weight_type": "linear",
        "combine_embeds": "average",
        "start_at": 0,
        "end_at": "{{end}}",
        "embeds_scaling": "V only"
      }
    }
  }
}
