{
  "name": "Style reference (IP-Adapter)",
  "description": "The project's style images, guiding the look of the whole frame.",
  "outputs": {
    "model": [
      "apply",
      0
    ]
  },
  "nodes": {
    "prep": {
      "class_type": "PrepImageForClipVision",
      "inputs": {
        "image": "{{in:image}}",
        "interpolation": "LANCZOS",
        "crop_position": "center",
        "sharpening": 0
      }
    },
    "apply": {
      "class_type": "IPAdapterAdvanced",
      "inputs": {
        "model": "{{in:model}}",
        "ipadapter": "{{in:ipadapter}}",
        "clip_vision": "{{in:clip_vision}}",
        "image": [
          "prep",
          0
        ],
        "weight": "{{weight}}",
        "weight_type": "style transfer",
        "combine_embeds": "average",
        "start_at": 0,
        "end_at": 1,
        "embeds_scaling": "V only"
      }
    }
  }
}
